<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="STFormat.Gui.MainWindow"
        Width="1100" Height="720"
        MinWidth="820" MinHeight="520"
        Title="STFormat — Formatter Structured Text">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="10,8" Background="{DynamicResource SystemControlBackgroundListLowBrush}">
            <DockPanel>
                <ComboBox x:Name="CbLang" DockPanel.Dock="Right" Width="130" SelectedIndex="1">
                    <ComboBoxItem>Italiano</ComboBoxItem>
                    <ComboBoxItem>English</ComboBoxItem>
                    <ComboBoxItem>Deutsch</ComboBoxItem>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnOpenFile" Content="Open file…"/>
                    <Button x:Name="BtnOpenFolder" Content="Open folder…"/>
                    <Rectangle Width="1" Fill="Gray" Margin="6,2" />
                    <Button x:Name="BtnSave" Content="Format &amp; save" IsEnabled="False"/>
                    <Button x:Name="BtnSaveAll" Content="Format all…" IsEnabled="False"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenuto -->
        <Grid Grid.Row="1" ColumnDefinitions="290,Auto,*">

            <!-- Pannello sinistro: impostazioni + lista file -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="10,10,4,10">

                <Border Grid.Row="0" Padding="12" CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="TxtSettings" Text="Settings" FontWeight="Bold" FontSize="14" />

                        <TextBlock x:Name="TxtIndentation" Text="Indentation" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton x:Name="RbSpaces" GroupName="Indent" Content="Spaces" IsChecked="True"/>
                            <RadioButton x:Name="RbTabs" GroupName="Indent" Content="Tabs"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSize" Text="Size" VerticalAlignment="Center" Width="90"/>
                            <NumericUpDown x:Name="NudIndentSize" Value="4" Minimum="1" Maximum="8"
                                           Increment="1" Width="110" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTabWidth" Text="Tab width" VerticalAlignment="Center" Width="90"/>
                            <NumericUpDown x:Name="NudTabWidth" Value="4" Minimum="1" Maximum="8"
                                           Increment="1" Width="110" FormatString="0"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtKeywords" Text="Keywords" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <ComboBox x:Name="CbKeywords" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem x:Name="KwUpper">UPPERCASE</ComboBoxItem>
                            <ComboBoxItem x:Name="KwLower">lowercase</ComboBoxItem>
                            <ComboBoxItem x:Name="KwPreserve">unchanged</ComboBoxItem>
                        </ComboBox>

                        <TextBlock x:Name="TxtAlignHeader" Text="Column alignment (tabs)" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <CheckBox x:Name="ChkAlignDecl" Content="Declarations ( : and := )" IsChecked="True"/>
                        <CheckBox x:Name="ChkAlignAssign" Content="Assignments ( := )" IsChecked="True"/>
                        <CheckBox x:Name="ChkAlignComments" Content="End-of-line comments" IsChecked="True"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="0,10,0,0" Padding="8" CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" x:Name="TxtFilesHeader" Text="Files" FontWeight="Bold" Margin="4,2,0,6"/>
                        <ListBox Grid.Row="1" x:Name="LstFiles"/>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent"/>

            <!-- Anteprima Prima / Dopo -->
            <Grid Grid.Column="2" ColumnDefinitions="*,Auto,*" Margin="4,10,10,10">
                <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" x:Name="TxtBeforeHeader" Text="Before" FontWeight="Bold" Padding="10,6"
                                   Background="{DynamicResource SystemControlBackgroundListLowBrush}"/>
                        <TextBox Grid.Row="1" x:Name="TxtBefore" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" FontFamily="Cascadia Code,Menlo,Consolas,monospace"
                                 FontSize="12" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" Background="Transparent"/>

                <Border Grid.Column="2" CornerRadius="6" ClipToBounds="True"
                        BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" x:Name="TxtAfterHeader" Text="After (formatted)" FontWeight="Bold" Padding="10,6"
                                   Background="{DynamicResource SystemControlBackgroundListLowBrush}"/>
                        <TextBox Grid.Row="1" x:Name="TxtAfter" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" FontFamily="Cascadia Code,Menlo,Consolas,monospace"
                                 FontSize="12" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Barra di stato -->
        <Border Grid.Row="2" Padding="10,6" Background="{DynamicResource SystemControlBackgroundListLowBrush}">
            <TextBlock x:Name="TxtStatus" Text="Open a file or folder to get started."/>
        </Border>
    </Grid>
</Window>
